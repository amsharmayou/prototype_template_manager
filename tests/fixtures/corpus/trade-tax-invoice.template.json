        "rateKey": "items.gst"
      },
      {
        "key": "subtotal",
        "op": "sum",
        "args": [
          "items.line"
        ]
      },
      {
        "key": "tax_total",
        "op": "sum",
        "args": [
          "items.line_gst"
        ]
      },
      {
        "key": "grand_total",
        "op": "add",
        "args": [
          "subtotal",
          "tax_total"
        ]
      },
      {
        "key": "round_off",
        "op": "round-off",
        "args": [
          "grand_total"
        ],
        "roundTo": 0
      },
      {
        "key": "payable",
        "op": "add",
        "args": [
          "grand_total",
          "round_off"
        ]
      },
      {
        "key": "worded",
        "op": "in-words",
        "args": [
          "payable"
        ]
      }
    ]
  },
