{
  "name": "bill-template-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixture": "tsx e2e/make-fixture.ts",
    "prepare:android-assets": "tsx tools/prepare-android-assets.ts",
    "build:share": "esbuild lib/share/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/sharekit.js",
    "build:billkit": "esbuild lib/billkit/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/billkit.js"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "canvas": false
  }
}
