{
  "name": "bill-template-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixture": "tsx e2e/make-fixture.ts",
    "fixture:build": "tsx tools/build-golden-fixture.ts",
    "prepare:android-assets": "tsx tools/prepare-android-assets.ts",
    "build:share": "esbuild lib/share/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/sharekit.js",
    "build:billkit": "esbuild lib/billkit/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/billkit.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.8.1",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.3",
    "lucide-react": "^1.58.0",
    "next": "16.3.7",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@expo-google-fonts/arimo": "^0.4.3",
    "@expo-google-fonts/caladea": "^0.4.2",
    "@expo-google-fonts/carlito": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "canvas": false
  }
}
