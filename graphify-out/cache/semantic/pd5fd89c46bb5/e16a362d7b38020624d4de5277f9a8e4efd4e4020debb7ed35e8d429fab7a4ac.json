{"nodes": [{"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer", "label": "Generalized HTML Document Renderer Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_pure_renderer", "label": "Pure HTML Renderer (renderHtml)", "file_type": "rationale", "rationale": "The renderer is a pure function of template and values with no Fabric, React, DOM or network dependency, so any host - web, share kit or server - can render a bill.", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_freehand_path_fix", "label": "Freehand Path Data Fix (Task 1)", "file_type": "rationale", "rationale": "Freehand strokes were dropped from every export because path data was not carried into the HTML; the fix corrects serialisation instead of special-casing the renderer.", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_canonical_json_sha256", "label": "Canonical JSON and SHA-256 (Task 2)", "file_type": "rationale", "rationale": "Canonical JSON and a hand-written SHA-256 make the template hash stable so goldens and packages can detect byte changes.", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_purity_guard_goldens", "label": "Golden Files and Purity Guard (Task 8)", "file_type": "rationale", "rationale": "A purity guard bans engine and impure imports inside lib/render and byte-for-byte goldens catch drift, so the renderer cannot silently become stateful.", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_export_target_wiring", "label": "Wire the HTML Document Export Target (Task 9)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_09_30_generalized_html_renderer", "target": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_pure_renderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_30_generalized_html_renderer", "target": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_freehand_path_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_30_generalized_html_renderer", "target": "docs_superpowers_plans_2026_09_30_generalized_html_renderer_canonical_json_sha256", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-30-generalized-html-renderer.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_30_generalized_html_renderer", "target": "docs_superpowers_plans_2026_09_30_gen