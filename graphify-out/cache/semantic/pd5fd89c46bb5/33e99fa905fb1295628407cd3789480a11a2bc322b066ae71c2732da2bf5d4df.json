{"nodes": [{"id": "docs_screenshots_plan3_4_mark_step_data_fields_screenshot", "label": "Mark data step screenshot (Bill Template Maker)", "file_type": "image", "source_file": "docs/screenshots/plan3/4-mark-step-data-fields.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshots_plan3_4_mark_step_data_fields_five_step_workflow", "label": "Five-step template authoring workflow", "file_type": "concept", "source_file": "docs/screenshots/plan3/4-mark-step-data-fields.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stepper (Your bill, Trace, Mark data, Test, Save & share) sequences template creation so each step has one job: capture the source bill, overlay its structure, tag variable data, verify with sample data, then export."}, {"id": "docs_screenshots_plan3_4_mark_step_data_fields_mark_data_step", "label": "Mark data step (step 3)", "file_type": "concept", "source_file": "docs/screenshots/plan3/4-mark-step-data-fields.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark what changes each time: fields, variables, repeating rows. Separating marking from drawing lets one traced template serve any bill instance by substituting data at fill time."}, {"id": "docs_screenshots_plan3_4_mark_step_data_fields_field_tool", "label": "Field tool", "file_type": "concept", "source_file": "docs/screenshots/plan3/4-mark-step-data-fields.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dedicated Field tool (keyboard shortcut F) keeps data-marking a distinct authoring mode from drawing, so variable regions are explicit objects rather than plain text."}, {"id": "docs_screenshots_plan3_4_mark_step_data_fields_data_field_placeholder", "label": "Data field placeholder {{customer_name}}", "