{"nodes": [{"id": "docs_superpowers_specs_2026_09_30_canvas_image_unification_design", "label": "Canvas and Image Unification Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-30-canvas-image-unification-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_30_canvas_image_unification_design_fabric_reference_object", "label": "Fabric-Bound Reference Image", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-30-canvas-image-unification-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_30_canvas_image_unification_design_reference_background", "label": "Reference Image as Canvas Background", "file_type": "rationale", "rationale": "Making the reference the canvas background instead of a locked object removes a whole class of leaks and makes image and canvas read as one surface.", "source_file": "docs/superpowers/specs/2026-09-30-canvas-image-unification-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_30_canvas_image_unification_design_zoom_at_cursor", "label": "Wheel Zoom at Cursor", "file_type": "rationale", "rationale": "Plain wheel zooms under the cursor so navigation needs no modifier keys and the point of interest stays fixed while zooming.", "source_file": "docs/superpowers/specs/2026-09-30-canvas-image-unification-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_30_canvas_image_unification_design_pan_clamp", "label": "Pan Clamp to Image Bounds", "file_type": "rationale", "rationale": "The viewport can never be panned past the image edge, so the page can never be lost off screen.", "source_file": "docs/su